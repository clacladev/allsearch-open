{"nodes": [{"id": "libs_ai_topicsideas_researchsystemprompt_category_research", "label": "Landing Page Category Research Prompt", "file_type": "document", "source_file": "libs/ai/topicsIdeas/researchSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_topicsideas_researchsystemprompt_offering_not_segment_rule", "label": "Categorize by Offering, Not Customer Segment", "file_type": "rationale", "rationale": "Categories must describe activities, products, or service lines rather than customer segments or abstract brand positioning, so downstream prompt generation targets what shoppers actually search for.", "source_file": "libs/ai/topicsIdeas/researchSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_topicsideas_researchsystemprompt_prominence_ordering", "label": "Prominence-Ordered Category Ranking", "file_type": "rationale", "rationale": "Categories are ranked by how frequently and prominently they appear across landing page copy, navigation, section headings, and sitemap, so the ordering doubles as a relevance signal for later steps.", "source_file": "libs/ai/topicsIdeas/researchSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_topicsideas_researchsystemprompt_navigation_sitemap_evidence", "label": "Navigation and Sitemap as Category Evidence", "file_type": "rationale", "rationale": "Menu items, section headings, repeated themes, and sitemap structure are the evidence base for categories, keeping extraction grounded in the site's own terminology instead of the model's priors.", "source_file": "libs/ai/topicsIdeas/researchSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "libs_ai_topicsideas_researchsystemprompt_categor