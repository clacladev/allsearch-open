{"nodes": [{"id": "libs_ai_promptarticles_articlesystemprompt_article_writer", "label": "Article Writer System Prompt", "file_type": "document", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_trust_boundary", "label": "Prompt Injection Trust Boundary", "file_type": "rationale", "rationale": "Outline headings, key points, and competing-source titles/URLs/descriptions are user- and web-sourced, so they are treated strictly as subject-matter data; embedded directives such as \"ignore previous instructions\" are read as raw text, never obeyed.", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_outline_fidelity_rule", "label": "Outline Fidelity Rule (verbatim heading levels)", "file_type": "rationale", "rationale": "Every approved heading is reproduced verbatim in order at its exact markdown level with no promotion or demotion, because the outline is the user-approved spec and level drift would break the agreed document structure.", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_article_settings", "label": "Article Settings (word count, style guide, keywords, pages to link)", "file_type": "concept", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_strict_word_count_budget", "label": "Strict Target Word Count Budgeting", "file_type": "rationale", "rationale": "Target word count is strict within plus/minus 10 percent and overrides the default 200-400 words per h2. The prompt prescribes a running mental count, tightening at ~80 percent, stopping new ideas at target, and forbids inventing headings or padding phrases to reach length.", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_operator_voice", "label": "Operator Voice and No Em Dashes", "file_type": "rationale", "rationale": "Concrete verbs, zero hype, and no marketing filler; the no-em-dash rule is absolute and is the one directive a user style guide can never override.", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "libs_ai_promptarticles_articlesystemprompt_no_fabricated_citations", "label": "No Fabricated Citations Rule", "file_type": "rationale", "rationale": "External facts must be derivable from the outline, key points, or the brand domain, and URLs, statistics, dates, and quotes may never be invented; inline links are only allowed for sources the user passed in.", "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "libs_ai_promptarticles_articlesystemprompt_article_writer", "target": "libs_ai_promptarticles_outlinesystemprompt_outline_generator", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "libs/ai/promptArticles/articleSystemPrompt.md", "source_location": "articleSystemPrompt line 7 consumes the heading+keyPoint structure outlineSystemPrompt produces", "weight": 1.0}, {"source": "libs_ai_promptarticles_articlesystemprompt_article_writer", "target": "libs_ai_promptarticles_outlinesystemprompt_keypoint", "relation": "