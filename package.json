{
  "name": "allsearch",
  "version": "0.1.0",
  "description": "Track how AI chatbots talk about your brand. Runs entirely on your own machine, against your own AI provider keys.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "dist/desktop/main.cjs",
  "bin": {
    "allsearch": "./dist/cli.mjs"
  },
  "files": [
    ".next/standalone",
    "dist",
    "drizzle",
    "README.md",
    "CONTEXT.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "build:cli": "bun scripts/buildCli.ts",
    "build:desktop:stage": "bun run build && bun scripts/buildDesktop.ts",
    "build:desktop": "bun run build:desktop:stage && electron-builder --config electron-builder.yml --mac dmg --arm64",
    "build:package": "bun run build && bun run build:cli",
    "prepack": "bun run build:package",
    "start": "next start",
    "start:cli": "node dist/cli.mjs",
    "start:desktop": "electron dist/desktop/main.cjs",
    "tsc": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:snapshot": "bun scripts/dbSnapshot.ts",
    "db:seed:demo": "bun scripts/dbSeedDemo.ts",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "e2e:prepare": "bun scripts/buildE2eDatabase.ts && bun run build",
    "test:e2e": "bun run e2e:prepare && playwright test --project chromium",
    "test:e2e:ai": "bun run e2e:prepare && PLAYWRIGHT_INCLUDE_AI=1 playwright test --project chromium --grep @ai",
    "test:e2e:visual": "bun run e2e:prepare && playwright test --project visual-light --project visual-dark --project visual-mobile",
    "test:e2e:ui": "bun run e2e:prepare && playwright test --ui",
    "test:desktop": "bun run build:package && bun scripts/buildDesktop.ts && playwright test --project desktop",
    "verify:providers": "bun scripts/verifyProviders.ts",
    "webhooks:listen": "ngrok http 3000 --url=super-pangolin-unlikely.ngrok-free.app",
    "deploy:prod": "git switch prod && git fetch origin && git rebase origin/dev && git push --force && git switch dev"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/perplexity": "^3.0.47",
    "@ai-sdk/provider": "^3.0.8",
    "@base-ui/react": "^1.7.0",
    "@mdxeditor/editor": "^3.55.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.168",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "drizzle-orm": "1.0.0-rc.4",
    "export-to-csv": "^1.4.0",
    "fflate": "^0.8.2",
    "html-to-docx": "^1.8.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.2",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdfmake": "^0.3.8",
    "react": "^19.2.8",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-tooltip": "^5.30.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.25.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/test-runner": "^0.24.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
